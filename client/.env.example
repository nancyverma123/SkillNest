# Browser → API (baked into the client bundle at build time). Use the API's PUBLIC URL.
VITE_API_URL=http://localhost:5000/api

# SSR server → API (runtime, server-side only). On Railway use the private network:
#   API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}/api
# Defaults to VITE_API_URL when not set.
API_URL=http://localhost:5000/api

# Port for the web server (Railway sets this automatically).
PORT=5173
