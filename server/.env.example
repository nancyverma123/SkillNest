PORT=5000
MONGO_URI=your_atlas_connection_string
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Optional
# Number of proxies in front of the API (1 on Render). Set 0 when running without a proxy.
TRUST_PROXY=1
# Max login/register attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# Tests only — must point to a LOCAL, disposable database whose name contains "test".
# TEST_MONGO_URI=mongodb://127.0.0.1:27018/skillnest_test
