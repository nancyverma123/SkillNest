{
  "name": "skillnest-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "seed": "node seed.js",
    "seed:reset": "node seed.js --reset",
