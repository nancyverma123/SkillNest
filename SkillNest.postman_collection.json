{
  "info": {
    "name": "SkillNest API",
    "description": "All SkillNest endpoints. Set {{baseUrl}}, then run \"Login (admin)\" and \"Login (student)\" first; tokens are saved to collection variables automatically. Running the whole collection in order exercises create → enroll → complete → unenroll → delete. Error responses are always { \"message\": \"...\" }. Credentials below are the documented demo accounts created by `npm run seed:reset` / `npm run dev:memory` — never production secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@skillnest.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123"
    },
    {
      "key": "studentEmail",
      "value": "student@skillnest.com"
    },
    {
      "key": "studentPassword",
      "value": "Student@123"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "enrollmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"postman.{{$timestamp}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is student', () => pm.expect(pm.response.json().user.role).to.eql('student'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
